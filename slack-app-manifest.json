{
  "display_information": {"name": "slackadm", "description": "Channel management with your own user permissions"},
  "oauth_config": {
    "redirect_urls": ["http://localhost:17839/callback"],
    "pkce_enabled": true,
    "scopes": {"user": ["channels:read", "channels:write", "groups:read", "groups:write", "users:read", "users:read.email"]}
  },
  "settings": {"org_deploy_enabled": false, "socket_mode_enabled": false, "token_rotation_enabled": true}
}
